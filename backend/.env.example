# Atlas Data Platform V3 production
DATABASE_URL=postgresql://user:pass@host/neondb?sslmode=require
GEMINI_API_KEY=
GROQ_API_KEY=
YOUTUBE_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong
VIEWER_USERNAME=viewer
VIEWER_PASSWORD=
JWT_SECRET=long-random-secret
JWT_EXPIRE_HOURS=12
ATLAS_API_KEY=
CORS_ORIGINS=https://your-app.vercel.app
APP_ENV=production
MAX_VIDEOS_PER_RUN=50
MAX_CONCURRENT_RUNS=1
MAX_RUNS_PER_HOUR=4
RATE_LIMIT_PER_MINUTE=30
ENABLE_EMBEDDINGS=false
ENABLE_INLINE_WORKER=true
YOUTUBE_DAILY_UNIT_BUDGET=8000
RUN_TIME_BUDGET_SECONDS=720
PROMPT_VERSION=vr_v1
ANALYSIS_VERSION=stats_v1
SLO_QUICK_RUN_SECONDS=900
